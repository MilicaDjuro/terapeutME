# Primjer razvojnih vrijednosti, bez produkcionih tajni.
# Kopirajte u .env u korijenu. API automatski učitava ovaj fajl.
DATABASE_URL=postgresql://terapeut:local-development-only@127.0.0.1:5432/terapeut
# Na Renderu: puna Neon direktna veza sa sslmode=require; isključite Connection pooling.
# Preuzmite je iz Neon Connect dijaloga i unesite samo u Render DATABASE_URL.
API_PORT=4000
# Render automatski zadaje PORT. Produkcija podrazumijeva API_HOST=0.0.0.0.
# API_HOST=127.0.0.1
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_ORIGIN=http://127.0.0.1:4000
# API_ORIGIN na Vercelu: https://vas-api.onrender.com, bez /api/v1 i završne kose crte.
# Next.js čita svoje env vrijednosti iz apps/web ili okruženja, ne iz ovog root .env fajla.
# Lokalni frontend već podrazumijeva API na portu 4000.
# Generišite: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Potpisuje JWT i štiti email kodove; promjena zahtijeva ponovnu prijavu.
# Ovo nije lozinka korisnika; nikad ga ne upisivati u NEXT_PUBLIC varijable.
AUTH_SECRET=

# Lokalno: kodovi, obnova lozinke i obavještenja o terminima stižu u Mailpit, ne na stvarni email.
# Sanduče: http://127.0.0.1:8025. Booking linkovi koriste prvu adresu iz WEB_ORIGINS.
AUTH_EMAIL_MODE=local
# Render Free prije uključivanja emaila: AUTH_EMAIL_MODE=disabled (API radi, registracija/reset ne šalju kodove).
# Kasnije Resend preko HTTPS-a, bez SMTP portova:
# AUTH_EMAIL_MODE=resend
# RESEND_API_KEY=ovdje-upisite-Resend-kljuc
# RESEND_FROM=Terapeut.me <noreply@vas-verifikovani-domen.me>
# Amazon SES preko HTTPS-a; nalog, DNS i IAM su objašnjeni u docs/aws-ses.md:
# AUTH_EMAIL_MODE=ses
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=ovdje-upisite-ograniceni-IAM-access-key
# AWS_SECRET_ACCESS_KEY=ovdje-upisite-ograniceni-IAM-secret-key
# SES_FROM=Terapeut.me <obavjestenja@mail.vas-domen.me>
# SES_FEEDBACK_EMAIL=vase-stvarno-nadgledano-sanduce@example.com
# SES_CONFIGURATION_SET=opciono-samo-ako-ste-ga-kreirali
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Terapeut.me <noreply@terapeut.me>
SMTP_USER=
SMTP_PASS=

# Stvarna dostava preko Resend-a, nakon verifikacije domena:
# AUTH_EMAIL_MODE=smtp
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=ovdje-lokalno-upisite-Resend-API-kljuc
# SMTP_FROM mora pripadati verifikovanom domenu.

# Video pozivi su isključeni dok ne kreirate Daily nalog; ključ ide samo na API server.
ONLINE_SESSIONS_PROVIDER=disabled
# ONLINE_SESSIONS_PROVIDER=daily
# DAILY_API_KEY=ovdje-lokalno-upisite-Daily-API-kljuc
# DAILY_DOMAIN=vas-daily-poddomen-bez-daily-co

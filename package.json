{
  "name": "terapeut-me",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@terapeut/web",
    "dev:api": "npm run dev --workspace=@terapeut/api",
    "build": "npm run build --workspace=@terapeut/web && npm run build --workspace=@terapeut/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@terapeut/domain",
    "test:e2e": "playwright test",
    "start": "npm run start --workspace=@terapeut/web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
